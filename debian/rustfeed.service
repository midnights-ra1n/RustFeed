[Unit]
Description=RustFeed RSS reader
After=network-online.target
Wants=network-online.target

[Service]
User=rustfeed
Group=rustfeed
# Configuration, account and articles live in /var/lib/rustfeed/data
WorkingDirectory=/var/lib/rustfeed
ExecStart=/usr/bin/RustFeed
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/rustfeed

[Install]
WantedBy=multi-user.target
